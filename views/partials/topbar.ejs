<header class="topbar">



    <div class="d-flex align-items-center">

        <!-- Mobile Sidebar -->

        <button class="btn btn-light border me-3 d-lg-none" id="mobileSidebar">

            <i class="bi bi-list fs-4"></i>

        </button>

        <!-- Desktop Sidebar Collapse -->

        <button class="btn btn-light border me-4 d-none d-lg-inline-flex" id="desktopSidebar">

            <i class="bi bi-layout-sidebar-inset"></i>

        </button>

        <!-- Search -->

        <div class="position-relative d-none d-md-block">


            RocketHub

        </div>

    </div>

    <!-- Right Side -->

    <div class="d-flex align-items-center">

        <!-- Fullscreen -->



        <!-- Notifications -->

        <div class="dropdown me-2">

            <button class="btn btn-light border rounded-circle position-relative" data-bs-toggle="dropdown">

                <i class="bi bi-bell"></i>

                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">

                    0

                </span>

            </button>

            <div class="dropdown-menu dropdown-menu-end shadow border-0 p-0" style="width:350px;">

                <div class="p-3 border-bottom">

                    <strong>Notifications</strong>

                </div>

                <a class="dropdown-item py-3" href="#">

                    <div class="fw-semibold">

                        Empty

                    </div>

                    <small class="text-secondary">

                        No new notifications

                    </small>

                </a>


            </div>

        </div>

        <!-- Messages -->

        <div class="dropdown me-3">

            <button class="btn btn-light border rounded-circle position-relative" data-bs-toggle="dropdown">

                <i class="bi bi-envelope"></i>

                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-primary">

                    0

                </span>

            </button>

            <div class="dropdown-menu dropdown-menu-end shadow border-0" style="width:350px;">

                <div class="p-3 border-bottom">

                    <strong>Messages</strong>

                </div>

                <a class="dropdown-item py-3">

                    <div class="fw-semibold">

                        Empty

                    </div>

                    <small class="text-secondary">

                        No new messages

                    </small>

                </a>


            </div>

        </div>

        <!-- User -->

        <div class="dropdown">

            <button class="btn border d-flex align-items-center" data-bs-toggle="dropdown">

                <img src="https://i.pravatar.cc/100?img=12" class="rounded-circle" width="40" height="40">

                <div class="ms-3 text-start d-none d-lg-block">

                    <div class="fw-semibold">

                        <%= user.email.split('@')[0] ? user.email.split('@')[0] : 'Guest' %>

                    </div>

                    <small class="text-secondary">

                        Administrator

                    </small>

                </div>

                <i class="bi bi-chevron-down ms-3"></i>

            </button>

            <ul class="dropdown-menu dropdown-menu-end shadow border-0">

                <li>

                    <a class="dropdown-item" href="#">

                        <i class="bi bi-person me-2"></i>

                        My Profile

                    </a>

                </li>

                <li>

                    <a class="dropdown-item" href="#">

                        <i class="bi bi-sliders me-2"></i>

                        Preferences

                    </a>

                </li>

                <li>

                    <a class="dropdown-item" href="#">

                        <i class="bi bi-lock me-2"></i>

                        Change Password

                    </a>

                </li>

                <li>

                    <hr class="dropdown-divider">

                </li>

                <li>

                    <a class="dropdown-item text-danger" href="/logout">

                        <i class="bi bi-box-arrow-right me-2"></i>

                        Logout

                    </a>

                </li>

            </ul>

        </div>

    </div>



</header>