<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>404 - Page Not Found</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {

            font-family: 'Inter', sans-serif;

            min-height: 100vh;

            display: flex;

            align-items: center;

            justify-content: center;

            overflow: hidden;

            background:
                radial-gradient(circle at top left,
                    rgba(37, 99, 235, .15),
                    transparent 35%),

                radial-gradient(circle at bottom right,
                    rgba(59, 130, 246, .10),
                    transparent 40%),

                #0f172a;
        }

        .error-card {

            width: 100%;
            max-width: 950px;

            border: none;

            border-radius: 24px;

            overflow: hidden;

            background: #111827;

            box-shadow:
                0 30px 80px rgba(0, 0, 0, .45);
        }

        .hero {

            background:
                radial-gradient(circle at top right,
                    rgba(59, 130, 246, .20),
                    transparent 45%),

                linear-gradient(135deg,
                    #172554,
                    #111827);

            color: white;

            min-height: 600px;
        }

        .logo {

            width: 64px;

            height: 64px;

            border-radius: 18px;

            background: #2563eb;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 28px;

            box-shadow:
                0 0 25px rgba(37, 99, 235, .35);
        }

        .error-number {

            font-size: 7rem;

            font-weight: 800;

            color: #60a5fa;

            line-height: 1;
        }

        .illustration {

            width: 220px;

            height: 220px;

            border-radius: 50%;

            background:
                radial-gradient(circle,
                    rgba(37, 99, 235, .25),
                    transparent);

            display: flex;

            align-items: center;

            justify-content: center;

            margin: auto;
        }

        .illustration i {

            font-size: 100px;

            color: #60a5fa;
        }

        .btn-primary {

            border-radius: 12px;

            padding: .9rem 2rem;
        }

        .btn-outline-light {

            border-radius: 12px;
        }

        @media(max-width:992px) {

            .hero {

                display: none;

            }

            .error-card {

                margin: 20px;

            }

        }
    </style>

</head>

<body>

    <div class="container">

        <div class="card error-card">

            <div class="row g-0">

                <!-- LEFT -->

                <div class="col-lg-5 hero d-flex align-items-center">

                    <div class="p-5 text-center w-100">

                        <div class="logo mx-auto mb-4">

                            <i class="bi bi-grid-fill"></i>

                        </div>

                        <h3 class="fw-bold">

                            RocketHub

                        </h3>

                        <p class="text-white-50">

                            Secure • Reliable • Connected

                        </p>

                        <div class="illustration mt-5">

                            <i class="bi bi-compass"></i>

                        </div>

                    </div>

                </div>

                <!-- RIGHT -->

                <div class="col-lg-7 bg-dark text-white d-flex align-items-center">

                    <div class="p-5">

                        <div class="error-number">

                            404

                        </div>

                        <h2 class="fw-bold mt-3">

                            Oops! We couldn't find that page.

                        </h2>

                        <p class="text-secondary mt-3 mb-4">

                            The page you're looking for may have been moved,
                            deleted, or the address may be incorrect.

                            Please check the URL or return to your dashboard.

                        </p>

                        <div class="d-flex flex-wrap gap-3">

                            <a href="/" class="btn btn-primary">

                                <i class="bi bi-house-door-fill me-2"></i>

                                Go Back Home

                            </a>


                        </div>


                    </div>

                </div>

            </div>

        </div>

    </div>

</body>

</html>