<%- include('partials/header'); -%>



    <%- include('partials/loader'); -%>


        <div class="wrapper">


            <%- include('partials/sidebar'); -%>


                <main class="main" id="main">

                    <%- include('partials/topbar'); -%>

                        <div class="content">


                            <div class="container-fluid">

                                <div class="row justify-content-center">

                                    <div class="col-xl-8">

                                        <!-- ==========================================
                    CREATE POST
            =========================================== -->

                                        <div class="card shadow-sm mb-4">

                                            <div class="card-body">

                                                <form action="/blogs" method="POST">

                                                    <div class="d-flex">

                                                        <img src="https://i.pravatar.cc/150?img=12"
                                                            class="rounded-circle me-3" width="50" height="50">

                                                        <div class="flex-grow-1">

                                                            <textarea name="content"
                                                                class="form-control border-0 bg-light" rows="3"
                                                                placeholder="What's happening today?"
                                                                required></textarea>

                                                        </div>

                                                    </div>

                                                    <hr>

                                                    <div
                                                        class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                                                        <div class="d-flex flex-wrap gap-2">

                                                            <input type="url" name="photo"
                                                                class="form-control form-control-sm"
                                                                placeholder="Photo URL (optional)"
                                                                style="width: 220px;">

                                                            <input type="url" name="video"
                                                                class="form-control form-control-sm"
                                                                placeholder="Video URL (optional)"
                                                                style="width: 220px;">

                                                            <input type="url" name="attachment"
                                                                class="form-control form-control-sm"
                                                                placeholder="Attachment URL (optional)"
                                                                style="width: 220px;">

                                                        </div>

                                                        <button type="submit" class="btn btn-primary px-4">

                                                            <i class="bi bi-send-fill me-2"></i>

                                                            Post

                                                        </button>

                                                    </div>

                                                </form>

                                            </div>

                                        </div>

                                        <% function getYouTubeEmbedUrl(url) { if (!url) return '' ; const
                                            normalizedUrl=url.trim(); const
                                            match=normalizedUrl.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/|live\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/i);
                                            return match ? `https://www.youtube.com/embed/${match[1]}` : '' ; } %>

                                            <% posts.forEach(post=> { %>
                                                <div class="card shadow-sm mb-3">
                                                    <div class="card-body">
                                                        <div class="d-flex align-items-center mb-3">
                                                            <img src="https://i.pravatar.cc/40?img=12"
                                                                class="rounded-circle me-3" width="40" height="40">
                                                            <div>
                                                                <strong>
                                                                    <%= post.author %>
                                                                </strong>
                                                                <div class="text-secondary small">
                                                                    <%= new Date(post.createdAt).toLocaleString() %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <p class="mb-0">
                                                            <%= post.content %>
                                                        </p>

                                                        <% if (post.photo) { %>
                                                            <div class="mt-3 rounded overflow-hidden bg-light d-flex justify-content-center align-items-center"
                                                                style="max-height: 420px;">
                                                                <img src="<%= post.photo %>" alt="Post photo"
                                                                    style="max-width: 100%; max-height: 420px; width: auto; height: auto; object-fit: contain; display: block;">
                                                            </div>
                                                            <% } %>

                                                                <% const youtubeEmbedUrl=getYouTubeEmbedUrl(post.video);
                                                                    %>
                                                                    <% if (youtubeEmbedUrl) { %>
                                                                        <div class="mt-3 rounded overflow-hidden">
                                                                            <div class="ratio ratio-16x9">
                                                                                <iframe
                                                                                    src="<%= youtubeEmbedUrl %>?rel=0"
                                                                                    title="YouTube video"
                                                                                    allowfullscreen loading="lazy"
                                                                                    referrerpolicy="strict-origin-when-cross-origin"
                                                                                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                                                                            </div>
                                                                        </div>
                                                                        <% } else if (post.video) { %>
                                                                            <div class="mt-3">
                                                                                <video class="w-100 rounded" controls>
                                                                                    <source src="<%= post.video %>">
                                                                                </video>
                                                                            </div>
                                                                            <% } %>

                                                                                <% if (post.attachment) { %>
                                                                                    <div class="mt-3">
                                                                                        <a href="<%= post.attachment %>"
                                                                                            target="_blank"
                                                                                            class="btn btn-outline-primary btn-sm">
                                                                                            <i
                                                                                                class="bi bi-paperclip me-2"></i>
                                                                                            Open attachment
                                                                                        </a>
                                                                                    </div>
                                                                                    <% } %>

                                                                                        <% if (user && user.email &&
                                                                                            post.author===user.email.split('@')[0])
                                                                                            { %>
                                                                                            <div
                                                                                                class="mt-3 d-flex justify-content-end">
                                                                                                <form
                                                                                                    action="/blogs/delete/<%= post._id %>"
                                                                                                    method="POST">
                                                                                                    <button
                                                                                                        type="submit"
                                                                                                        class="btn btn-outline-danger btn-sm">
                                                                                                        <i
                                                                                                            class="bi bi-trash me-2"></i>
                                                                                                        Delete
                                                                                                    </button>
                                                                                                </form>
                                                                                            </div>
                                                                                            <% } %>
                                                    </div>
                                                </div>
                                                <% }) %>

                                    </div>



                                    <div class="col-xl-4 d-none d-xl-block">

                                        <div class="card shadow-sm mb-4">

                                            <div class="card-header bg-white">

                                                <strong>

                                                    Upcoming Events

                                                </strong>

                                            </div>

                                            <div class="list-group list-group-flush">

                                                <a href="#" class="list-group-item">

                                                    Team Meeting
                                                    <br>

                                                    <small class="text-secondary">
                                                        Tomorrow • 9:00 AM
                                                    </small>

                                                </a>

                                                <a href="#" class="list-group-item">

                                                    Product Launch

                                                    <br>

                                                    <small class="text-secondary">

                                                        Friday

                                                    </small>

                                                </a>

                                                <a href="#" class="list-group-item">

                                                    Client Presentation

                                                    <br>

                                                    <small class="text-secondary">

                                                        Monday

                                                    </small>

                                                </a>

                                            </div>

                                        </div>

                                        <div class="card shadow-sm">

                                            <div class="card-header bg-white">

                                                <strong>

                                                    Online Team

                                                </strong>

                                            </div>

                                            <div class="card-body">

                                                <div class="d-flex align-items-center mb-3">

                                                    <img src="https://i.pravatar.cc/40?img=12"
                                                        class="rounded-circle me-3">

                                                    <%= user.email.split('@')[0] %>

                                                        <span class="badge bg-success ms-auto">

                                                            Online

                                                        </span>

                                                </div>



                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>



                        </div>


                        <%- include('partials/footer'); -%>